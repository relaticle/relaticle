# path= is a name watch: the kernel tracks the parent directory, so the deploy's mv over .env keeps it covered.
# perm=rwa catches a file moved out, read and moved back. The b32 lines cover 32-bit syscalls.
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/.env -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b32 -F path=/home/forge/relaticle.com/.env -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/storage/oauth-private.key -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b32 -F path=/home/forge/relaticle.com/storage/oauth-private.key -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/bootstrap/cache/config.php -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b32 -F path=/home/forge/relaticle.com/bootstrap/cache/config.php -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/.config/relaticle/secret-reader.json -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b32 -F path=/home/forge/.config/relaticle/secret-reader.json -F perm=rwa -k relaticle-secrets
-a always,exit -F arch=b64 -F dir=/home/forge/backups -F perm=r -k relaticle-secrets
-a always,exit -F arch=b32 -F dir=/home/forge/backups -F perm=r -k relaticle-secrets
-e 2
