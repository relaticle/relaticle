# path= is a name watch: the kernel tracks the parent directory, so the deploy's mv over .env keeps it covered.
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/.env -F perm=r -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/storage/oauth-private.key -F perm=r -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/relaticle.com/bootstrap/cache/config.php -F perm=r -k relaticle-secrets
-a always,exit -F arch=b64 -F path=/home/forge/.config/relaticle/secret-reader.json -F perm=r -k relaticle-secrets
-a always,exit -F arch=b64 -F dir=/home/forge/backups -F perm=r -k relaticle-secrets
-e 2
